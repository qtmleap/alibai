+
+# --- TTS: OpenAI互換の読み上げAPI ---
+# /v1 までのベースURL。実際の送信先は ${TTS_URL}/audio/speech。
+TTS_URL=https://ai.qleap.jp/v1
+# 必須: 上流で公開されているTTSモデルIDを指定する。モデル名は自動で推測しない。
+# TTS_URL または TTS_MODEL が空なら音声は無効（文字だけのプレイは継続）。
+TTS_MODEL=
+# 認証が必要なサーバのBearerキー。OPENAI_API_KEYは自動流用しない。
+TTS_API_KEY=
+# ローカルでは .dev.vars がある場合はそちらに設定する。
+# 本番は同名のWorkers設定/secretへ登録する。実キーはこのファイルに書かない。
+# 既存の話者IDを voice に渡すので、新しい上流にも同じIDの話者登録が必要。
