# ============================================================================
# AlibAI — 環境変数テンプレート
# Dev Container 初回作成時に .env としてコピーされる。
# 実際のキーを書いた .env は絶対にコミットしないこと（.gitignore 済み）。
# ============================================================================

# --- データストア ---
# Workers ランタイムは Hyperdrive バインディング経由で接続するため DATABASE_URL を読まない。
# ここに書く値は drizzle-kit（マイグレーション）とローカル開発用。
DATABASE_URL=postgres://alibai:alibai@db:5432/alibai

# --- LLM: 役割ごとにプロバイダを選ぶ ---
# anthropic | openai | google
# 混成してよい。例: actorはClaude、judgeはGeminiのFlash系
LLM_ACTOR_PROVIDER=anthropic
LLM_JUDGE_PROVIDER=anthropic
LLM_AUTHOR_PROVIDER=anthropic

# --- モデルIDの上書き（未設定ならプロバイダ既定を使う） ---
# 既定値は src/server/llm/provider.ts の DEFAULT_MODELS を参照。
# モデルIDは各社とも改定が速いので、採用前に公式ドキュメントで確認すること。
# LLM_ACTOR_MODEL=
# LLM_JUDGE_MODEL=
# LLM_AUTHOR_MODEL=

# --- APIキー: 使うプロバイダの分だけあればよい ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
