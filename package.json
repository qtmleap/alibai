{
  "name": "alibai",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply alibai --local",
    "db:migrate:remote": "wrangler d1 migrations apply alibai --remote",
    "db:seed": "bun run db/seed.ts",
    "db:seed:apply": "wrangler d1 execute alibai --local --file=db/seed.sql",
    "db:seed:apply:remote": "wrangler d1 execute alibai --remote --file=db/seed.sql",
    "db:author": "bun run db/generate-scenario.ts",
    "se:fetch": "bun run scripts/fetch-se.ts",
    "deploy": "bun run se:fetch && bun run build && bun run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/google": "^2",
    "@ai-sdk/openai": "^2",
    "@ai-sdk/provider-utils": "^3",
    "@commitlint/config-conventional": "^21.2.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.44",
    "hono": "^4",
    "lucide-react": "^1.37.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.6.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^4",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31",
    "playwright": "^1.62.1",
    "storybook": "10.5.10",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8",
    "wrangler": "^4",
    "yaml": "^2.9.0"
  }
}
