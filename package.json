{
  "name": "alibai",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply alibai --local",
    "db:migrate:remote": "wrangler d1 migrations apply alibai --remote",
    "db:seed": "bun run db/seed.ts",
    "db:seed:apply": "wrangler d1 execute alibai --local --file=db/seed.sql",
    "db:seed:apply:remote": "wrangler d1 execute alibai --remote --file=db/seed.sql",
    "db:author": "bun run db/generate-scenario.ts",
    "se:fetch": "bun run scripts/fetch-se.ts",
    "deploy": "bun run se:fetch && bun run build && bun run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/provider-utils": "^5.0.36",
    "@commitlint/config-conventional": "^21.2.2",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitlint": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.42.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0",
    "yaml": "^2.9.0"
  }
}
